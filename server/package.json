{
  "name": "agentic-rag-backend",
  "version": "1.0.0",
  "description": "An AI chatbot uses AI agents to answer user questions",
  "author": "Asif Shahzad",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "npx tsx --watch --env-file=.env src/server.ts",
    "build": "cd ../client && npm install && npm run build -- --outDir ../server/public --emptyOutDir",
    "check-clients": "npx tsx --env-file=.env scripts/check-clients.ts",
    "create-index": "npx tsx --env-file=.env scripts/create-index.ts",
    "ingest": "npx tsx --env-file=.env scripts/ingest.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@pinecone-database/pinecone": "^9.0.0",
    "express": "^5.3.0",
    "openai": "^7.39.0"
  }
}
